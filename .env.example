# =============================================================================
# RERUN CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
# =============================================================================

# --- Solver LLM Configuration ---
SOLVER_PROVIDER=gemini
SOLVER_MODEL=gemini-3.5-flash-lite
SOLVER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/gemini
SOLVER_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Critic LLM Configuration (Independent reviewer - Groq OpenAI GPT-OSS 120B) ---
CRITIC_PROVIDER=groq
CRITIC_MODEL=openai/gpt-oss-120b
CRITIC_BASE_URL=https://api.groq.com/openai/v1
CRITIC_API_KEY=gsk_PLACEHOLDER_GROQ_API_KEY
GROQ_API_KEY=gsk_PLACEHOLDER_GROQ_API_KEY

# --- Fallback LLM Configuration (Used automatically on primary provider failure) ---
FALLBACK_PROVIDER=gemini
FALLBACK_MODEL=gemini-3.5-flash-lite
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/gemini
FALLBACK_API_KEY=YOUR_GEMINI_API_KEY_HERE

# --- Execution & Sandbox Mode ---
# SANDBOX_TYPE: 'docker' (default, production isolation) or 'fake' (for unit testing)
SANDBOX_TYPE=docker
# ALLOW_FAKE_SANDBOX: must be set to '1' if SANDBOX_TYPE=fake is used
ALLOW_FAKE_SANDBOX=0

# --- LLM Mode ---
# LLM_MODE: 'live' (queries configured API) or 'replay' (uses recorded cassettes)
LLM_MODE=live
CASSETTE_DIR=data/cassettes

# --- Optional Gemini API Key Pool (Multi-key rotation engine) ---
GEMINI_API_KEYS=
KEY_ROTATION_THRESHOLD=100

# --- Budget & Safety Limits ---
MAX_STEPS=40
MAX_PATCHES=3
CRITIC_ROUNDS_MAX=2
RUN_TIMEOUT_S=600
INSTALL_TIMEOUT_S=300
DIAGNOSE_STEPS_MAX=8

# --- Container Resource Limits ---
SANDBOX_CPUS=2
SANDBOX_MEM=2g
SANDBOX_PIDS=256

# --- Patch Size & Policy Limits ---
MAX_FILES=5
MAX_CHANGED_LINES=200
LARGE_PATCH_FILES=2
LARGE_PATCH_LINES=20
LOG_CAP_BYTES=2000000

# --- Hardware Acceleration (Optional) ---
GPU_ENABLED=false
GPU_COUNT=1
GPU_IMAGE=rerun-gpu:py311

# --- Workspace & Directory Paths ---
DATA_DIR=data
WHEELHOUSE_DIR=wheelhouse
BENCH_DIR=benchmarks
